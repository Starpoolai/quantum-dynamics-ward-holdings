<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quantum Dynamics Corp. Ward Holdings</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <div class="game-shell">
      <div class="ambient-grid"></div>
      <div class="ambient-scanlines"></div>

      <header class="hud-top">
        <section class="hud-block compact">
          <div class="panel-title">Facility Status</div>
          <div class="status-stack">
            <div class="status-line">
              <span>Compute Load</span>
              <div class="mini-bar"><span style="width: 68%"></span></div>
            </div>
            <div class="status-line">
              <span>Vector Memory</span>
              <div class="mini-bar"><span style="width: 84%"></span></div>
            </div>
            <div class="status-line label-row">
              <span>Network Uptime</span>
              <strong>99.7%</strong>
            </div>
          </div>
        </section>

        <section class="hud-block compact">
          <div class="panel-title">Overseer Nodes</div>
          <div class="node-row">
            <button class="overseer-node active" data-overseer="gemini">
              <span class="node-emoji">🔮</span>
              <span>Gemini-Prime</span>
            </button>
            <button class="overseer-node active" data-overseer="chatgpt">
              <span class="node-emoji">⚡</span>
              <span>ChatGPT-Core</span>
            </button>
          </div>
        </section>
      </header>

      <div class="dashboard-layout">
        <aside class="side-panel console-panel">
          <div class="panel-title">Hermes Console</div>
          <div class="console-form">
            <input id="command-input" type="text" value="open squad 1" aria-label="Hermes command input" />
            <button id="submit-command">EXEC</button>
          </div>
          <div class="command-hints">
            Try: open squad 1 • open comms • boost department analytics 7 • set alert amber • summon nova
          </div>
          <div id="command-log" class="log-box" aria-live="polite"></div>
        </aside>

        <main class="main-panel">
          <section class="sphere-block sphere-alpha">
            <div class="sphere-header">
              <div>
                <span class="eyebrow">Sphere Alpha</span>
                <h1>Deck Vista / Tactical Command Array</h1>
              </div>
              <span class="deck-tag">Gemini-Prime Oversight</span>
            </div>

            <div class="bay-grid">
              <article class="bay selected" data-room="executive" data-sphere="alpha">
                <div class="bay-header">
                  <span class="bay-code">Squad 1</span>
                  <h2>Executive Throne Room</h2>
                </div>
                <div class="officer-grid">
                  <button class="officer" data-role="chairman">👑<span>Chairman</span></button>
                  <button class="officer" data-role="queen">🌟<span>Queen</span></button>
                  <button class="officer" data-role="reaper">💀<span>Reaper</span></button>
                  <button class="officer" data-role="ceo">📊<span>CEO</span></button>
                  <button class="officer" data-role="cfo">💰<span>CFO</span></button>
                </div>
                <div class="metric-row">
                  <span>Compound Growth</span>
                  <div class="bar"><span style="width: 73%"></span></div>
                  <strong>+847%</strong>
                </div>
                <div class="metric-note">Succession countdown: 20 years</div>
              </article>

              <article class="bay" data-room="security" data-sphere="alpha">
                <div class="bay-header">
                  <span class="bay-code">Squad 2</span>
                  <h2>Security & Testing Lab</h2>
                </div>
                <div class="officer-grid">
                  <button class="officer" data-role="cso">🛡️<span>CSO</span></button>
                  <button class="officer" data-role="cqo">⚔️<span>CQO</span></button>
                  <button class="officer" data-role="cto">🔧<span>CTO</span></button>
                  <button class="officer" data-role="coo">⚙️<span>COO</span></button>
                </div>
                <div class="log-block">
                  <div class="log-title">Mem0 / Anthropic Feed</div>
                  <div class="mini-log">Vector cache: 12.4M embeddings</div>
                  <div class="mini-log">Threat posture: optimal</div>
                  <div class="mini-log">Exposure: 0.02%</div>
                </div>
              </article>
            </div>
          </section>

          <section class="sphere-block sphere-beta">
            <div class="sphere-header">
              <div>
                <span class="eyebrow">Sphere Beta</span>
                <h1>Dispatch / Panopticon Array</h1>
              </div>
              <span class="deck-tag">ChatGPT-Core Oversight</span>
            </div>

            <div class="bay-grid">
              <article class="bay" data-room="dispatch" data-sphere="beta">
                <div class="bay-header">
                  <span class="bay-code">Squad 3</span>
                  <h2>Dispatch Center & Tool Foundry</h2>
                </div>
                <div class="officer-grid">
                  <button class="officer" data-role="cmao">📡<span>CMAO</span></button>
                  <button class="officer" data-role="crco">🔀<span>CRCO</span></button>
                  <button class="officer" data-role="chief_of_staff">📋<span>Chief of Staff</span></button>
                  <button class="officer" data-role="tool_manager">🛠️<span>Tool Manager</span></button>
                </div>
                <div class="loop-visual">
                  <div class="loop-indicator"></div>
                  <div class="loop-indicator"></div>
                  <div class="loop-indicator"></div>
                  <div class="loop-indicator"></div>
                  <div class="loop-indicator"></div>
                </div>
                <div class="metric-note">Awesome Harness Engineering loops: adaptive</div>
              </article>

              <article class="bay" data-room="comms" data-sphere="beta">
                <div class="bay-header">
                  <span class="bay-code">Squad 4</span>
                  <h2>Panopticon & Comms Deck</h2>
                </div>
                <div class="officer-grid">
                  <button class="officer" data-role="nova">🌌<span>Nova</span></button>
                  <button class="officer" data-role="synth_broker">💱<span>Synthetix Broker</span></button>
                  <button class="officer" data-role="sentinel">👁️<span>Sentinel</span></button>
                </div>
                <div class="log-block">
                  <div class="log-title">Browser Use / Mobile Feed</div>
                  <div class="mini-log">Mobile integration: live</div>
                  <div class="mini-log">Scout threads: 47 active</div>
                  <div class="mini-log">Viewport fidelity: optimized</div>
                </div>
              </article>
            </div>
          </section>

          <section class="progress-panel">
            <div class="panel-title">Department Hill-Climb Eval Progress</div>
            <div class="progress-grid">
              <div class="progress-item" data-dept="Executive Ops">
                <span>Executive Ops</span>
                <div class="bar"><span style="width: 92%"></span></div>
                <strong>92%</strong>
              </div>
              <div class="progress-item" data-dept="Security">
                <span>Security</span>
                <div class="bar"><span style="width: 78%"></span></div>
                <strong>78%</strong>
              </div>
              <div class="progress-item" data-dept="Testing">
                <span>Testing</span>
                <div class="bar"><span style="width: 65%"></span></div>
                <strong>65%</strong>
              </div>
              <div class="progress-item" data-dept="Dispatch">
                <span>Dispatch</span>
                <div class="bar"><span style="width: 88%"></span></div>
                <strong>88%</strong>
              </div>
              <div class="progress-item" data-dept="Comms">
                <span>Comms</span>
                <div class="bar"><span style="width: 82%"></span></div>
                <strong>82%</strong>
              </div>
              <div class="progress-item" data-dept="Vector DB">
                <span>Vector DB</span>
                <div class="bar"><span style="width: 91%"></span></div>
                <strong>91%</strong>
              </div>
              <div class="progress-item" data-dept="AI Ops">
                <span>AI Ops</span>
                <div class="bar"><span style="width: 76%"></span></div>
                <strong>76%</strong>
              </div>
              <div class="progress-item" data-dept="Data Eng">
                <span>Data Eng</span>
                <div class="bar"><span style="width: 84%"></span></div>
                <strong>84%</strong>
              </div>
              <div class="progress-item" data-dept="Network">
                <span>Network</span>
                <div class="bar"><span style="width: 94%"></span></div>
                <strong>94%</strong>
              </div>
              <div class="progress-item" data-dept="Storage">
                <span>Storage</span>
                <div class="bar"><span style="width: 87%"></span></div>
                <strong>87%</strong>
              </div>
              <div class="progress-item" data-dept="Memory Mgt">
                <span>Memory Mgt</span>
                <div class="bar"><span style="width: 79%"></span></div>
                <strong>79%</strong>
              </div>
              <div class="progress-item" data-dept="Cache Layer">
                <span>Cache Layer</span>
                <div class="bar"><span style="width: 89%"></span></div>
                <strong>89%</strong>
              </div>
              <div class="progress-item" data-dept="Sync Svc">
                <span>Sync Svc</span>
                <div class="bar"><span style="width: 81%"></span></div>
                <strong>81%</strong>
              </div>
              <div class="progress-item" data-dept="Logging">
                <span>Logging</span>
                <div class="bar"><span style="width: 93%"></span></div>
                <strong>93%</strong>
              </div>
              <div class="progress-item" data-dept="Monitoring">
                <span>Monitoring</span>
                <div class="bar"><span style="width: 86%"></span></div>
                <strong>86%</strong>
              </div>
              <div class="progress-item" data-dept="Analytics">
                <span>Analytics</span>
                <div class="bar"><span style="width: 77%"></span></div>
                <strong>77%</strong>
              </div>
              <div class="progress-item" data-dept="Infra">
                <span>Infra</span>
                <div class="bar"><span style="width: 95%"></span></div>
                <strong>95%</strong>
              </div>
            </div>
          </section>

          <section class="worker-floor">
            <div class="panel-title">Minion Worker Floor</div>
            <div class="ticker-wrap">
              <div class="ticker-track">
                <span>Task pool active — parsing Open Viking windows</span>
                <span>signed event logging stable</span>
                <span>background evals executing</span>
                <span>cache invalidation cycle nominal</span>
                <span>distributed consensus: 99.9% agreement</span>
              </div>
            </div>
          </section>
        </main>

        <aside class="side-panel state-panel">
          <div class="panel-title">Live State Log</div>
          <div id="state-log" class="state-log" aria-live="polite"></div>
        </aside>
      </div>

      <div id="npc-layer" class="npc-layer"></div>
      <div id="message-popup" class="message-popup hidden">
        <div class="message-box">
          <div class="message-header">
            <span id="message-speaker">SYSTEM</span>
            <button class="panel-close" id="close-message">✕</button>
          </div>
          <div id="message-content" class="message-content"></div>
        </div>
      </div>
    </div>

    <script src="script.js"></script>
  </body>
</html>
