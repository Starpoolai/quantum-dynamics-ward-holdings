function populateInitialLogs() {
  const baseMessages = [
    'Tracker online: all floors nominal.',
    'Hermes relay is synchronized with all tactical rooms.',
    'Selected room: Executive Throne Room.',
    'Worker floor: background tasks are parsing Open Viking windows.'
  ];

  baseMessages.forEach((message) => pushStateLog(message));
  pushToLog(commandLog, 'SYSTEM', 'Locating active ward sectors...');
  pushToLog(commandLog, 'SYSTEM', 'Hermes relay initialized.');
}

const NPC_LIBRARY = [
  { name: 'NOVA', icon: '🌌', mood: 'triangulate' },
  { name: 'ECHO', icon: '📡', mood: 'scan' },
  { name: 'CIPHER', icon: '🔐', mood: 'encrypt' },
  { name: 'PULSE', icon: '⚡', mood: 'surge' },
  { name: 'REACHER', icon: '🤖', mood: 'route' },
  { name: 'GLITCH', icon: '📊', mood: 'stabilize' }
];

class WanderingNPC {
  constructor(character, index) {
    this.character = character;
    this.index = index;
    this.x = 20 + Math.random() * (window.innerWidth - 120);
    this.y = 80 + Math.random() * (window.innerHeight - 200);
    this.vx = (Math.random() - 0.5) * 1.2;
    this.vy = (Math.random() - 0.5) * 1.2;
    this.boundaryX = window.innerWidth;
    this.boundaryY = window.innerHeight;
    this.el = document.createElement('div');
    this.el.className = 'npc';
    this.el.innerHTML = `<div class="npc-name">${character.name}</div><div class="npc-icon">${character.icon}</div>`;
    this.el.addEventListener('click', () => {
      const greeting = `${character.name}: ${this.randomMessage()}`;
      displayMessage(character.name, greeting);
      pushStateLog(greeting);
    });
    npcLayer.appendChild(this.el);
    this.tick = 0;
  }

  randomMessage() {
    const messages = [
      'Subsystems are humming in the corridors.',
      'The lower decks are reporting low-noise telemetry.',
      'A subtle pulse of energy is moving through the station.',
      'Data threads are aligning with the tactical grid.',
      'I saw a new pattern in the wall systems.',
      'The city is listening. So are we.'
    ];
    return messages[Math.floor(Math.random() * messages.length)];
  }

  step() {
    this.tick += 1;
    this.x += this.vx;
    this.y += this.vy;

    if (this.x < 20 || this.x > this.boundaryX - 80) this.vx *= -1;
    if (this.y < 70 || this.y > this.boundaryY - 120) this.vy *= -1;

    if (this.tick % 120 === 0) {
      this.vx = (Math.random() - 0.5) * 1.8;
      this.vy = (Math.random() - 0.5) * 1.8;
    }

    this.el.style.left = `${this.x}px`;
    this.el.style.top = `${this.y}px`;
  }
}

let npcList = [];

function initNPCs() {
  const count = 6;
  for (let i = 0; i < count; i++) {
    npcList.push(new WanderingNPC(NPC_LIBRARY[i % NPC_LIBRARY.length], i));
  }
}

function animateNPCs() {
  npcList.forEach((npc) => npc.step());
  requestAnimationFrame(animateNPCs);
}

window.addEventListener('resize', () => {
  npcList.forEach((npc) => {
    npc.boundaryX = window.innerWidth;
    npc.boundaryY = window.innerHeight;
  });
});

window.addEventListener('load', () => {
  populateInitialLogs();
  setSelectedRoom('executive');
  initNPCs();
  animateNPCs();
  setAlert('stabilized');
  setTimeout(() => displayMessage('HERMES', 'Ward Holdings command deck live. Deck status stable.'), 1200);
});

